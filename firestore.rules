rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'anhung81@gmail.com' ||
        request.auth.token.email == 'luong-hung@hotmail.com' ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    function isAdmin() {
      return isEmailAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for Users
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             (data.role == 'customer' || data.role == 'admin') &&
             data.createdAt is int;
    }

    // Validation helper for Menu Items
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.allergens is list &&
             (data.price is float || data.price is int) &&
             data.category is string &&
             data.isSoldOut is bool &&
             data.createdAt is int;
    }

    // Validation helper for Orders
    function isValidOrder(data) {
      return data.customerId is string && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerEmail is string && data.customerEmail.size() <= 200 &&
             data.items is list &&
             (data.totalPrice is float || data.totalPrice is int) &&
             (data.pickupTimeType == 'heti' || data.pickupTimeType == 'kellonaika') &&
             data.status is string &&
             data.createdAt is int;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isEmailAdmin();
      allow list: if isEmailAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isEmailAdmin()) && isValidUser(request.resource.data);
      allow delete: if isEmailAdmin();
    }

    // Menu collection
    match /menu/{itemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidMenuItem(request.resource.data);
      allow update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if (isAdmin() || (
        isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'peruutettu' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      )) && isValidOrder(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
